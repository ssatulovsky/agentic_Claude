# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.
# En producción, estos valores vienen del gestor de secretos de la nube.

NODE_ENV=development
PUERTO=3000

# Conexión de la aplicación: rol erp_app (sin privilegios para saltarse la seguridad por fila).
DATABASE_URL=postgres://erp_app:CAMBIAR@localhost:5432/erp

# Conexión del servicio de autenticación: rol erp_auth (único con acceso a contraseñas y sesiones).
DATABASE_URL_AUTH=postgres://erp_auth:CAMBIAR@localhost:5432/erp

# Conexión de migraciones y operaciones de plataforma: rol erp_owner.
DATABASE_URL_MIGRACIONES=postgres://erp_owner:CAMBIAR@localhost:5432/erp

# Clave maestra AES-256 (32 bytes en hexadecimal). Genérela con: openssl rand -hex 32
CLAVE_MAESTRA_CIFRADO=

SESION_DURACION_HORAS=8
SESION_INACTIVIDAD_MINUTOS=30
LIMITE_LOGIN_POR_MINUTO=10
# Cantidad de proxies inversos propios delante del servidor (0 si no hay ninguno).
PROXIES_CONFIABLES=0
MFA_EMISOR=ERP Agentico

# Opcional: clave gratuita de la API de la CMF (api.cmfchile.cl). Con ella, la UF y la
# UTM se concilian entre dos fuentes antes de guardarse.
CMF_API_KEY=
